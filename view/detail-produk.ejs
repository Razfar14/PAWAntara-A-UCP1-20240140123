<%- include('partials/header', { title: product ? product.name : 'Produk Tidak Ditemukan' }) %>
<%- include('partials/navbar') %>

<main class="container product-section">
    <% if (product) { %>
        <article class="detail-card">
            <img src="<%= product.image || 'https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=500&q=80' %>" alt="<%= product.name %>" class="detail-img">
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div>
                    <span class="category-badge"><%= product.category %></span>
                    <h1 class="hero-title" style="color: var(--slate-900); text-align: left; font-size: 2rem; margin-top: 0.5rem;"><%= product.name %></h1>
                </div>
                <p style="color: var(--slate-500); font-size: 0.875rem; line-height: 1.6;"><%= product.description || 'Produk kebutuhan pokok segar dan berkualitas untuk kebutuhan dapur keluarga Anda.' %></p>
                <div class="product-price" style="font-size: 1.5rem;">Rp <%= product.price.toLocaleString('id-ID') %></div>
                <div style="font-size: 0.875rem; color: var(--slate-500);">Stok Tersedia: <strong style="color: var(--slate-800);"><%= product.stock %> unit</strong></div>
                <div style="margin-top: 0.5rem;">
                    <a href="/produk" class="btn-detail" style="font-size: 0.875rem; padding: 0.5rem 1rem;">← Kembali ke Katalog</a>
                </div>
            </div>
        </article>
    <% } else { %>
        <div style="background-color: #ffffff; border: 1px solid var(--slate-200); border-radius: 1rem; padding: 3rem; text-align: center;">
            <h1 style="color: #dc2626; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">Produk Tidak Ditemukan</h1>
            <p style="color: var(--slate-500); font-size: 0.875rem; margin-bottom: 1.5rem;">Maaf, ID produk yang Anda cari tidak ada atau telah dihapus.</p>
            <a href="/produk" class="btn-emerald">Kembali ke Daftar Produk</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
